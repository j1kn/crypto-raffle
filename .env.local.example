# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WalletConnect Configuration
# Get your project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-32-character-project-id

# Admin Configuration
# Comma-separated list of wallet addresses that can access the admin panel
ADMIN_WALLETS=0xYourWalletAddress1,0xYourWalletAddress2
# PIN for the /superman admin setup page
ADMIN_PIN=your-secure-pin
